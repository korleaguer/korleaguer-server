#!/usr/bin/env bash
# 코리거 배포 스크립트(서버의 /usr/local/bin/korleaguer-deploy). GitHub Actions가 SSH로 부른다.
#
# 배포 계정의 authorized_keys가 키마다 이 스크립트와 서비스를 고정한다:
#   restrict,command="/usr/local/bin/korleaguer-deploy api" ssh-ed25519 AAAA... gha-korleaguer-server
# 그래서 키가 새어도 정해진 서비스를 재배포하는 것 말고는 할 수 없다.
# Actions가 보낸 명령(SSH_ORIGINAL_COMMAND)은 배포할 이미지 이름표만 받는다: 커밋 해시 "sha-1a2b3c4"(지속 배포),
# 또는 예전 버전 형식 "0.2.0".
# 표준입력 두 줄: GHCR 사용자 이름, 그 배포 job의 임시 토큰(GITHUB_TOKEN, packages:read).
# 토큰은 임시 폴더에서 docker login에만 쓰고 바로 지운다. 서버에 오래 남는 토큰은 없다.
#
# 블루-그린: 웹·API는 자리가 둘(blue·green)이다. 지금 받는 쪽은 .env의 WEB_LIVE·API_LIVE이고,
# Caddy는 live/web.caddy·live/api.caddy에 적힌 컨테이너로 보낸다(웹 → API도 Caddy의 안쪽 포트 8080을 거친다).
# 순서: 이미지 받기 → mysql·caddy가 떠 있게 → (api면) DB 백업 → 쉬는 자리에 새 버전을 띄움 → healthy를 기다림
#       → 데우기(api: 미리 채우기를 마칠 때까지 /actuator/warm, web: 주요 화면을 두 번씩 불러 봄)
#       → Caddy가 새 자리로 보내게(live 파일을 쓰고 caddy reload, 하던 요청은 끊기지 않는다) → 옛 자리를 멈춘다.
#       옛 자리는 지우지 않고 멈춘 채 둔다(급하면 다시 켜고 live 파일만 되돌리면 된다). 다음 배포가 그 자리를 쓴다.
#       새 자리가 healthy가 안 되면 지우고 태그를 되돌린다(옛 자리가 계속 받는다).
#       데우기가 시간 안에 안 끝나면 경고를 남기고 그대로 넘긴다(데우지 않은 채 받기 시작한다).
# 직접 실행(서버에서 재배포·롤백): korleaguer-deploy api sha-1a2b3c4 (이미지가 이미 있으면 KORLEAGUER_SKIP_PULL=1)
set -euo pipefail

DEPLOY_DIR="${KORLEAGUER_DIR:-/srv/korleaguer}"
SERVICE="${1:-}"
VERSION="${SSH_ORIGINAL_COMMAND:-${2:-}}"
HEALTH_TIMEOUT="${KORLEAGUER_HEALTH_TIMEOUT:-300}"
WARM_TIMEOUT="${KORLEAGUER_WARM_TIMEOUT:-180}"
# Caddy가 새 자리로 보낸 뒤 옛 자리를 멈추기까지 최대로 기다리는 시간(옛 자리로 이미 간 요청이 끝나게).
# 옛 자리에 들어온 연결이 다 끝나면 그 전에라도 바로 멈춘다(drain_old).
# API는 멈출 때도 하던 요청을 마치지만(graceful), 웹(Next.js)은 그렇지 않아 연결이 남아 있으면 넉넉히 기다린다.
DRAIN_SECONDS="${KORLEAGUER_DRAIN_SECONDS:-15}"
BACKUP_BIN="${KORLEAGUER_BACKUP_BIN:-/usr/local/bin/korleaguer-backup}"
KEEP_IMAGES=3

log() { printf '[%s] %s\n' "$(date '+%F %T')" "$*"; }
fail() { log "실패: $*" >&2; exit 1; }

case "$SERVICE" in
  api) PREFIX=API; PORT=8080; IMAGE=ghcr.io/korleaguer/korleaguer-server ;;
  web) PREFIX=WEB; PORT=3000; IMAGE=ghcr.io/korleaguer/korleaguer-web ;;
  *) fail "서비스는 api 또는 web이어야 합니다: '${SERVICE}'" ;;
esac
[[ "$VERSION" =~ ^(sha-[0-9a-f]{7,40}|[0-9]+\.[0-9]+\.[0-9]+)$ ]] \
  || fail "배포할 이미지 이름표(예: sha-1a2b3c4)가 아닙니다: '${VERSION}'"

cd "$DEPLOY_DIR"
[ -f compose.yaml ] || fail "${DEPLOY_DIR}/compose.yaml이 없습니다(서버 준비 스크립트를 먼저 실행하세요)"
touch .env

# SSH가 중간에 끊겨도(Actions 취소, 네트워크) 배포를 끝까지 마친다: 끊김 신호(HUP)와 끊긴 출력(PIPE)을 무시하고,
# 모든 출력을 deploy.log에 남기면서 SSH로도 보낸다(tee는 SSH 쪽이 끊겨도 로그 파일에는 계속 쓴다).
trap '' HUP PIPE
if tee --help 2>&1 | grep -q -- '--output-error'; then
  exec > >(tee --output-error=warn-nopipe -a "$DEPLOY_DIR/deploy.log") 2>&1
else
  exec > >(tee -a "$DEPLOY_DIR/deploy.log") 2>&1
fi

# 두 저장소(여러 대화)의 배포가 겹치지 않게 한 번에 하나만 돈다. 앞의 배포가 끝날 때까지 최대 10분 기다린다.
if command -v flock > /dev/null; then
  exec 9> "$DEPLOY_DIR/.deploy.lock"
  flock -w 600 9 || fail "다른 배포가 10분 안에 끝나지 않았습니다"
fi

compose() { docker compose "$@"; }

env_value() { grep -E "^$1=" .env | tail -n 1 | cut -d= -f2- || true; }

set_env() {
  local key="$1" value="$2"
  sed -i.bak -E "/^${key}=/d" .env && rm -f .env.bak
  if [ -n "$value" ]; then
    printf '%s=%s\n' "$key" "$value" >> .env
  fi
}

# 컨테이너 이름 앞부분(compose.yaml의 container_name과 같다). 시험 환경은 .env에 COMPOSE_PROJECT_NAME을 둔다.
PROJECT="$(env_value COMPOSE_PROJECT_NAME)"
PROJECT="${PROJECT:-korleaguer}"
CADDY="${PROJECT}-caddy"

# 서비스의 한 자리 컨테이너 이름. 예: container api green → korleaguer-api-green
container() { printf '%s-%s-%s' "$PROJECT" "$1" "$2"; }

# Caddy가 보낼 곳(live/<서비스>.caddy). 파일을 통째로 바꿔 쓴다(반쯤 쓴 파일을 Caddy가 읽지 않게).
write_live() {
  local svc="$1" upstream="$2" tmp
  mkdir -p live
  tmp="$(mktemp "live/.${svc}.XXXXXX")"
  cat > "$tmp" <<EOF
# korleaguer-deploy가 쓴다. 손으로 고치지 않는다. 지금 받는 ${svc}: ${upstream}
reverse_proxy ${upstream} {
	# 바꾸는 순간 접속이 끊기면 30초까지 다시 시도한다(502 대신 잠깐 기다림)
	lb_try_duration 30s
	lb_try_interval 500ms
}
EOF
  chmod 644 "$tmp"
  mv "$tmp" "live/${svc}.caddy"
}

# Caddy가 읽는 live 파일이 없으면 만든다. 지금 받는 자리(.env의 *_LIVE)를, 아직 배포 전이면 blue를 가리킨다(배포 전에는 502).
ensure_live() {
  local web_live api_live
  web_live="$(env_value WEB_LIVE)"
  api_live="$(env_value API_LIVE)"
  [ -f live/web.caddy ] || write_live web "$(container web "${web_live:-blue}"):3000"
  [ -f live/api.caddy ] || write_live api "$(container api "${api_live:-blue}"):8080"
}

caddy_reload() { docker exec "$CADDY" caddy reload --config /etc/caddy/Caddyfile > /dev/null; }

# 컨테이너가 healthy가 될 때까지 기다린다. 헬스체크가 없으면 running이면 된다.
# unhealthy는 바로 실패로 보지 않는다: 서버가 바쁘면 자바가 이미지의 시작 유예(90초)보다 늦게 떠서 잠깐 unhealthy였다가
# healthy가 된다(2026-11-11 시험에서 150초 넘게 걸림). 컨테이너가 꺼졌거나 시간이 다 되면 실패다.
wait_healthy() {
  local id="$1" deadline=$((SECONDS + HEALTH_TIMEOUT)) status
  while :; do
    status="$(docker inspect -f '{{if .State.Health}}{{.State.Health.Status}}{{else}}{{.State.Status}}{{end}}' "$id" 2> /dev/null || echo gone)"
    case "$status" in
      healthy) return 0 ;;
      running) docker inspect -f '{{if .State.Health}}x{{end}}' "$id" | grep -q x || return 0 ;;
      exited | dead | gone) return 1 ;;
    esac
    [ "$SECONDS" -ge "$deadline" ] && return 1
    sleep 1
  done
}

# API 데우기: 앱이 미리 채우기(홈·선수·내 선수 카드)를 마칠 때까지 기다린다(GET /actuator/warm이 200).
# 404면 이 버전에 그 엔드포인트가 없다(예전 버전으로 되돌릴 때): 기다리지 않는다.
warm_api() {
  local name="$1" deadline=$((SECONDS + WARM_TIMEOUT)) code
  while :; do
    code="$(docker exec "$name" curl -s -o /dev/null -w '%{http_code}' http://127.0.0.1:8080/actuator/warm 2> /dev/null || true)"
    case "$code" in
      200) log "미리 채우기를 마쳤습니다"; return 0 ;;
      404) log "이 버전에는 /actuator/warm이 없어 기다리지 않습니다"; return 0 ;;
    esac
    if [ "$SECONDS" -ge "$deadline" ]; then
      log "경고: ${WARM_TIMEOUT}초 안에 미리 채우기가 끝나지 않았습니다(마지막 응답 ${code:-없음}). 그대로 넘깁니다"
      return 0
    fi
    sleep 1
  done
}

# 웹 데우기: 새 컨테이너 안에서 주요 화면(홈·선수·내 선수·선수 상세 전부)을 두 번씩 불러 본다.
# Node·Next.js는 막 떴을 때 처음 몇 번 그리기가 느리다. API는 지금 받는 쪽(Caddy)을 부른다.
# 한 회 안에서는 화면들을 동시에 부른다(차례로 부르면 화면 수만큼 기다린다).
WEB_WARM_JS='
const base = "http://127.0.0.1:3000";
async function get(path) {
  const started = Date.now();
  try {
    const res = await fetch(base + path, { signal: AbortSignal.timeout(30000) });
    const body = await res.text();
    return { status: res.status, ms: Date.now() - started, body };
  } catch (e) {
    return { status: "error", ms: Date.now() - started, body: "" };
  }
}
(async () => {
  const list = await get("/players");
  const ids = [...new Set([...list.body.matchAll(/href="\/players\/(\d+)"/g)].map((m) => m[1]))];
  const pages = ["/", "/players", "/my", ...ids.map((id) => "/players/" + id)];
  for (let round = 1; round <= 2; round++) {
    const results = await Promise.all(pages.map((page) => get(page)));
    const report = results.map((r, i) => pages[i] + " " + r.status + " " + r.ms + "ms");
    console.log("데우기 " + round + "회: " + report.join(", "));
  }
})();
'
warm_web() {
  local name="$1"
  docker exec "$name" node -e "$WEB_WARM_JS" || log "경고: 웹 데우기 중 오류가 났습니다(그대로 넘깁니다)"
}

# 옛 자리로 이미 간 요청이 끝나기를 기다린다(최대 DRAIN_SECONDS). 옛 자리의 서비스 포트에 맺힌 연결
# (/proc/net/tcp·tcp6에서 그 포트의 ESTABLISHED)이 없으면 끝난 것으로 본다. 연결 수를 못 읽으면 최대 시간까지 기다린다.
# 옛 자리가 이미 꺼져 있으면 기다리지 않는다.
drain_old() {
  local name="$1" port_hex out count="" deadline=$((SECONDS + DRAIN_SECONDS)) started=$SECONDS
  [ "$(docker inspect -f '{{.State.Running}}' "$name" 2> /dev/null || true)" = true ] || return 0
  port_hex="$(printf '%04X' "$PORT")"
  while [ "$SECONDS" -lt "$deadline" ]; do
    if out="$(docker exec "$name" sh -c 'cat /proc/net/tcp; cat /proc/net/tcp6 2> /dev/null; true' 2> /dev/null)"; then
      count="$(awk -v p=":${port_hex}" '$2 ~ (p "$") && $4 == "01" { n++ } END { print n + 0 }' <<< "$out")"
      if [ "$count" = 0 ]; then
        log "옛 자리로 간 요청이 끝났습니다($((SECONDS - started))초)"
        return 0
      fi
    fi
    sleep 0.5
  done
  log "옛 자리 연결이 ${DRAIN_SECONDS}초 안에 다 끝나지 않았습니다(남은 연결 ${count:-알 수 없음}). 멈춥니다"
}

# 예전 방식(compose 서비스 이름 그대로 'web'·'api', 배포마다 숫자가 붙던) 컨테이너를 내린다.
# 블루-그린으로 옮긴 뒤 처음 배포할 때 한 번 걸린다.
stop_legacy() {
  local legacy
  legacy="$(docker ps -aq --filter "label=com.docker.compose.project=${PROJECT}" \
    --filter "label=com.docker.compose.service=${SERVICE}")"
  [ -n "$legacy" ] || return 0
  log "예전 방식 컨테이너를 내립니다: $(docker inspect -f '{{.Name}}' $legacy | tr -d '/' | tr '\n' ' ')"
  docker stop --time 30 $legacy > /dev/null || true
  docker rm $legacy > /dev/null || true
}

# 쉬는 자리에 새 버전을 띄워 데운 뒤 Caddy가 그쪽으로 보내게 하고, 옛 자리를 멈춘다.
rollout() {
  local live idle new_name old_name tag_var previous_tag
  live="$(env_value "${PREFIX}_LIVE")"
  if [ "$live" = blue ]; then idle=green; else idle=blue; fi
  new_name="$(container "$SERVICE" "$idle")"
  tag_var="${PREFIX}_${idle^^}_TAG"
  previous_tag="$(env_value "$tag_var")"

  log "새 버전을 쉬는 자리(${idle})에 띄웁니다: ${new_name}"
  set_env "$tag_var" "$VERSION"
  if ! compose up -d --no-deps --force-recreate "${SERVICE}-${idle}"; then
    set_env "$tag_var" "$previous_tag"
    return 1
  fi
  log "${new_name}가 healthy가 되기를 기다립니다(최대 ${HEALTH_TIMEOUT}초)"
  if ! wait_healthy "$new_name"; then
    docker logs --tail 80 "$new_name" >&2 || true
    compose rm -sf "${SERVICE}-${idle}" > /dev/null 2>&1 || true
    set_env "$tag_var" "$previous_tag"
    return 1
  fi

  log "데웁니다(최대 ${WARM_TIMEOUT}초)"
  "warm_${SERVICE}" "$new_name"

  log "Caddy가 ${new_name}로 보내게 합니다"
  [ -f "live/${SERVICE}.caddy" ] && cp "live/${SERVICE}.caddy" "live/.${SERVICE}.caddy.previous"
  write_live "$SERVICE" "${new_name}:${PORT}"
  if ! caddy_reload; then
    log "Caddy 설정을 다시 읽지 못해 되돌립니다"
    [ -f "live/.${SERVICE}.caddy.previous" ] && mv "live/.${SERVICE}.caddy.previous" "live/${SERVICE}.caddy"
    caddy_reload || true
    compose rm -sf "${SERVICE}-${idle}" > /dev/null 2>&1 || true
    set_env "$tag_var" "$previous_tag"
    return 1
  fi
  rm -f "live/.${SERVICE}.caddy.previous"
  set_env "${PREFIX}_LIVE" "$idle"

  # 옛 자리로 이미 간 요청이 끝나기를 기다린 뒤 멈춘다(API는 하던 요청을 마치고 내려간다).
  if [ -n "$live" ]; then
    old_name="$(container "$SERVICE" "$live")"
    drain_old "$old_name"
    log "옛 자리를 멈춥니다(지우지 않고 둔다): ${old_name}"
    docker stop --time 30 "$old_name" > /dev/null 2>&1 || true
  fi
  stop_legacy
}

previous="$(env_value "${PREFIX}_TAG")"
live_now="$(env_value "${PREFIX}_LIVE")"
log "배포 시작: ${SERVICE} ${previous:-없음} → ${VERSION} (지금 받는 자리: ${live_now:-없음})"

# 1) 이미지 받기. 로그인 정보는 임시 폴더에만 두고 바로 지운다.
if [ "${KORLEAGUER_SKIP_PULL:-0}" != 1 ]; then
  IFS= read -r ghcr_user || true
  IFS= read -r ghcr_token || true
  [ -n "${ghcr_user:-}" ] && [ -n "${ghcr_token:-}" ] || fail "표준입력으로 GHCR 사용자와 토큰을 받지 못했습니다"
  login_dir="$(mktemp -d)"
  trap 'rm -rf "$login_dir"' EXIT
  printf '%s' "$ghcr_token" | DOCKER_CONFIG="$login_dir" docker login ghcr.io -u "$ghcr_user" --password-stdin > /dev/null
  unset ghcr_token
  DOCKER_CONFIG="$login_dir" docker pull --quiet "${IMAGE}:${VERSION}" > /dev/null || fail "이미지를 받지 못했습니다: ${IMAGE}:${VERSION}"
  rm -rf "$login_dir"
fi
docker image inspect "${IMAGE}:${VERSION}" > /dev/null 2>&1 || fail "서버에 이미지가 없습니다: ${IMAGE}:${VERSION}"

# 2) 기반 서비스(DB, 리버스 프록시)가 떠 있게 한다. 이미 떠 있으면 그대로다.
ensure_live
compose up -d --no-deps --wait mysql
compose up -d --no-deps caddy

# 3) API를 바꾸기 전에 DB를 백업한다(새 코드가 DB 구조를 바꿀 수 있어서). 백업 이름은 before-<이미지 이름표>.
if [ "$SERVICE" = api ]; then
  "$BACKUP_BIN" "before-${VERSION}" || fail "DB 백업에 실패해 배포를 멈춥니다"
fi

# 4) 바꾸기. 실패하면 받는 쪽은 그대로다.
if ! rollout; then
  fail "${SERVICE} ${VERSION}이 정상 상태가 되지 않아 넘기지 않았습니다(${previous:-없음} 그대로)"
fi
set_env "${PREFIX}_TAG" "$VERSION"

# 5) 이 서비스의 오래된 이미지는 최근 ${KEEP_IMAGES}개만 남긴다(롤백용). 쓰고 있는 이미지는 지워지지 않는다.
docker image ls "$IMAGE" --format '{{.Repository}}:{{.Tag}}' | tail -n +$((KEEP_IMAGES + 1)) | xargs -r docker image rm > /dev/null 2>&1 || true

log "배포 완료: ${SERVICE} ${VERSION} (받는 자리: $(env_value "${PREFIX}_LIVE"))"
