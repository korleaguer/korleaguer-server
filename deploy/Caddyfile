# 코리거 리버스 프록시. 주소(SITE_ADDRESS)는 compose의 환경변수다.
# 도메인이면 HTTPS 인증서를 자동으로 받고 http는 https로 넘긴다. ":80"이면 http만.
#
# 블루-그린 배포: 지금 받는 웹·API는 live/web.caddy·live/api.caddy에 적혀 있다(/etc/caddy/live).
# 배포 스크립트(korleaguer-deploy)가 새 자리를 데운 뒤 그 파일을 바꾸고 'caddy reload' 한다.
# reload는 하던 요청을 끊지 않는다. 손으로 고치지 않는다.

# 앞에 서버의 nginx가 있으면(서버 안쪽 주소로 들어온다) 그 nginx가 붙인 X-Forwarded-For·Proto를 믿고 그대로 넘긴다.
{
	servers {
		trusted_proxies static private_ranges
	}
}

# 밖에서 오는 요청 → 지금 받는 웹
{$SITE_ADDRESS} {
	encode zstd gzip
	import /etc/caddy/live/web.caddy
}

# 안쪽(도커 망)에서만: 웹 → 지금 받는 API. compose가 이 포트를 밖으로 열지 않는다.
http://:8080 {
	import /etc/caddy/live/api.caddy
}
