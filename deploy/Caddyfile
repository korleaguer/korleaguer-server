# 코리거 리버스 프록시. 주소(SITE_ADDRESS)는 compose의 환경변수다.
# 도메인이면 HTTPS 인증서를 자동으로 받고 http는 https로 넘긴다. ":80"이면 http만.
#
# 블루-그린 배포: 지금 받는 웹·API는 live/web.caddy·live/api.caddy에 적혀 있다(/etc/caddy/live).
# 배포 스크립트(korleaguer-deploy)가 새 자리를 데운 뒤 그 파일을 바꾸고 'caddy reload' 한다.
# reload는 하던 요청을 끊지 않는다. 손으로 고치지 않는다.

# 앞에 서버의 nginx가 있으면(서버 안쪽 주소로 들어온다) 그 nginx가 붙인 X-Forwarded-For·Proto를 믿고 그대로 넘긴다.
{
	servers {
		trusted_proxies static private_ranges
	}
}

# 밖에서 오는 요청 → 지금 받는 웹
{$SITE_ADDRESS} {
	encode zstd gzip

	# 접근 기록: 방문 수·재방문·앱 비율을 세려고 남긴다(집계는 tools/access-report.py). 보관 90일(roll_keep_for).
	# - 파일은 호스트의 /srv/korleaguer/logs/access.log(compose가 /var/log/caddy로 마운트). 10MiB마다 새로 굴리고 옛것은 gzip.
	# - 개인정보: IP는 IPv4 /24·IPv6 /48까지만 남기고 쿠키·Authorization 등은 지운다. User-Agent·Next-Router-Prefetch·Referer는 센다고 남긴다.
	# - 정적 파일(js·css·이미지·글꼴)과 /healthz는 기록하지 않는다(세는 데 필요 없고 기록이 커진다).
	@no_log path /_next/static/* /_next/image* /healthz
	@no_log_ext path_regexp \.(?:js|css|map|png|jpe?g|gif|webp|avif|svg|ico|woff2?|ttf)$
	log_skip @no_log
	log_skip @no_log_ext
	log {
		output file /var/log/caddy/access.log {
			mode 0644
			roll_size 10MiB
			roll_keep 60
			roll_keep_for 2160h
		}
		format filter {
			wrap json
			request>remote_ip ip_mask {
				ipv4 24
				ipv6 48
			}
			request>client_ip ip_mask {
				ipv4 24
				ipv6 48
			}
			request>remote_addr delete
			request>remote_port delete
			request>tls delete
			request>headers>Cookie delete
			request>headers>Authorization delete
			request>headers>Proxy-Authorization delete
			request>headers>X-Forwarded-For delete
			request>headers>X-Real-Ip delete
			request>headers>Forwarded delete
			request>headers>Accept delete
			request>headers>Accept-Encoding delete
			request>headers>Accept-Language delete
			request>headers>Cache-Control delete
			request>headers>Pragma delete
			request>headers>Priority delete
			request>headers>Connection delete
			request>headers>Dnt delete
			request>headers>Upgrade-Insecure-Requests delete
			request>headers>Sec-Fetch-Dest delete
			request>headers>Sec-Fetch-Mode delete
			request>headers>Sec-Fetch-Site delete
			request>headers>Sec-Fetch-User delete
			request>headers>Sec-Ch-Ua delete
			request>headers>Sec-Ch-Ua-Mobile delete
			request>headers>Sec-Ch-Ua-Platform delete
			resp_headers delete
		}
	}

	import /etc/caddy/live/web.caddy
}

# 안쪽(도커 망)에서만: 웹 → 지금 받는 API. compose가 이 포트를 밖으로 열지 않는다.
http://:8080 {
	import /etc/caddy/live/api.caddy
}
